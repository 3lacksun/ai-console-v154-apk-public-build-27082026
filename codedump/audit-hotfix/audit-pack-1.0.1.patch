+  function addPhaseRelevance(record, phaseId, minScore, reason) {
+    const current=Number(record.classification.phaseScores[phaseId]||0);
+    record.classification.phaseScores[phaseId]=Math.max(current,minScore);
+    if(record.classification.primaryPhase!==phaseId && !record.classification.secondaryPhases.includes(phaseId)) record.classification.secondaryPhases.push(phaseId);
+    record.classification.secondaryPhases.sort((a,b)=>a-b);
+    const reasons=record.classification.phaseReasons[phaseId] || [];
+    reasons.push(reason);
+    record.classification.phaseReasons[phaseId]=[...new Set(reasons)].slice(0,8);
+  }
